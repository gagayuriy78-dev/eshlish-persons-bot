[Unit]
Description=ISHLISH PERSONS Telegram Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ishlishbot
Group=ishlishbot
WorkingDirectory=/opt/ishlish-persons-bot
EnvironmentFile=/etc/ishlish-persons-bot.env
ExecStart=/opt/ishlish-persons-bot/.venv/bin/python -u /opt/ishlish-persons-bot/main.py
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
StateDirectory=ishlish-persons-bot
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/ishlish-persons-bot

[Install]
WantedBy=multi-user.target
